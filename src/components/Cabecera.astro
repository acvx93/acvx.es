---
import TemaToggle from './TemaToggle.astro';
import SelectorIdioma from './SelectorIdioma.astro';
import { RUTAS, UI, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
  alternas?: Partial<Record<Idioma, string>>;
}

const { idioma, alternas = {} } = Astro.props;
const t = UI[idioma];
const r = RUTAS[idioma];
const aqui = Astro.url.pathname.replace(/\/?$/, '/');

const enlaces = [
  { href: r.sobre, texto: t.navSobre },
  { href: r.ensayos, texto: t.navEnsayos },
];

const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const destinoIdioma = alternas[otroIdioma] ?? RUTAS[otroIdioma].inicio;
---

<header class="cabecera">
  <div class="envoltorio cabecera__fila">
    <a class="marca" href={r.inicio} aria-label="ACVx">
      <svg class="marca__delta" viewBox="0 0 690 718" aria-hidden="true" focusable="false">
        <path fill-rule="evenodd" d="M0 718 277 0h136l277 718zm223-130h244L345 272z" />
      </svg><span aria-hidden="true">CVx</span>
    </a>
    <nav class="navegacion" aria-label={t.navInicio}>
      {
        enlaces.map((enlace) => (
          <a href={enlace.href} aria-current={aqui.startsWith(enlace.href) ? 'page' : undefined}>
            {enlace.texto}
          </a>
        ))
      }
      <span class="controles">
        <SelectorIdioma idioma={idioma} destino={destinoIdioma} />
        <TemaToggle idioma={idioma} />
      </span>
    </nav>
  </div>
</header>
