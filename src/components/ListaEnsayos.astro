---
import { formatearFecha, type Idioma } from '../i18n/ui';
import { slugDe, urlDe, type Entrada } from '../lib/ensayos';

interface Props {
  entradas: Entrada[];
  idioma: Idioma;
}

const { entradas, idioma } = Astro.props;
---

<ul class="lista-ensayos">
  {
    entradas.map((entrada, i) => (
      <li class="entrada-ensayo revelar">
        <a href={urlDe(entrada)}>
          <span class="entrada-ensayo__indice">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <h3 class="entrada-ensayo__titulo" style={`view-transition-name: ensayo-${slugDe(entrada)}`}>
              {entrada.data.titulo}
            </h3>
            <p class="entrada-ensayo__resumen">{entrada.data.descripcion}</p>
          </span>
          <time class="entrada-ensayo__fecha" datetime={entrada.data.fecha.toISOString().slice(0, 10)}>
            {formatearFecha(entrada.data.fecha, idioma)}
          </time>
        </a>
      </li>
    ))
  }
</ul>
