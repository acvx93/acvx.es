---
import { formatearFecha, type Idioma } from '../i18n/ui';
import { urlDe, type Entrada } from '../lib/ensayos';

interface Props {
  entradas: Entrada[];
  idioma: Idioma;
}

const { entradas, idioma } = Astro.props;
---

<ul class="lista-ensayos">
  {
    entradas.map((entrada) => (
      <li>
        <time class="entrada__fecha" datetime={entrada.data.fecha.toISOString().slice(0, 10)}>
          {formatearFecha(entrada.data.fecha, idioma)}
        </time>
        <h3 class="entrada__titulo"><a href={urlDe(entrada)}>{entrada.data.titulo}</a></h3>
        <p class="entrada__resumen">{entrada.data.descripcion}</p>
      </li>
    ))
  }
</ul>
