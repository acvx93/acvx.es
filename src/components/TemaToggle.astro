---
import { UI, type Idioma } from '../i18n/ui';

const { idioma } = Astro.props as { idioma: Idioma };
const t = UI[idioma];
---

<button
  class="boton-icono"
  type="button"
  data-tema-boton
  data-etiqueta-auto={t.temaAutomatico}
  data-etiqueta-light={t.temaClaro}
  data-etiqueta-dark={t.temaOscuro}
  aria-label={t.temaAutomatico}
  title={t.temaAutomatico}
>
  <svg class="tema-icono tema-icono--auto" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M8 1.75A6.25 6.25 0 0 1 8 14.25Z" fill="currentColor"></path>
  </svg>
  <svg class="tema-icono tema-icono--light" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
    <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13m7.64 7.64 1.13 1.13m0-9.9-1.13 1.13m-7.64 7.64-1.13 1.13" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
  </svg>
  <svg class="tema-icono tema-icono--dark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M12.8 10.9A5.8 5.8 0 0 1 5.1 3.2 5.8 5.8 0 1 0 12.8 10.9Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
  </svg>
</button>

<script is:inline>
  {
    const boton = document.querySelector('[data-tema-boton]');
    if (boton) {
      const raiz = document.documentElement;
      const modos = ['auto', 'light', 'dark'];
      const modoActual = () => raiz.dataset.tema === 'light' || raiz.dataset.tema === 'dark' ? raiz.dataset.tema : 'auto';
      const actualizarEtiqueta = () => {
        const etiqueta = boton.getAttribute('data-etiqueta-' + modoActual());
        if (etiqueta) {
          boton.setAttribute('aria-label', etiqueta);
          boton.setAttribute('title', etiqueta);
        }
      };
      actualizarEtiqueta();
      boton.addEventListener('click', () => {
        const siguiente = modos[(modos.indexOf(modoActual()) + 1) % modos.length];
        if (siguiente === 'auto') delete raiz.dataset.tema;
        else raiz.dataset.tema = siguiente;
        try {
          if (siguiente === 'auto') localStorage.removeItem('tema');
          else localStorage.setItem('tema', siguiente);
        } catch (e) {}
        actualizarEtiqueta();
      });
    }
  }
</script>
