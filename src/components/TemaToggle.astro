---
import { UI, type Idioma } from '../i18n/ui';

const { idioma } = Astro.props as { idioma: Idioma };
const t = UI[idioma];
---

<button
  class="boton-icono"
  type="button"
  data-tema-boton
  data-etiqueta-light={t.temaClaro}
  data-etiqueta-dark={t.temaOscuro}
  aria-label={t.temaOscuro}
  title={t.temaOscuro}
>
  <svg class="tema-icono tema-icono--sol" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
    <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13m7.64 7.64 1.13 1.13m0-9.9-1.13 1.13m-7.64 7.64-1.13 1.13" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
  </svg>
  <svg class="tema-icono tema-icono--luna" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M12.8 10.9A5.8 5.8 0 0 1 5.1 3.2 5.8 5.8 0 1 0 12.8 10.9Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
  </svg>
</button>

<script is:inline>
  {
    const boton = document.querySelector('[data-tema-boton]');
    if (boton) {
      const raiz = document.documentElement;
      const sistemaOscuro = window.matchMedia('(prefers-color-scheme: dark)');
      const modoActual = () => raiz.dataset.tema === 'light' || raiz.dataset.tema === 'dark'
        ? raiz.dataset.tema
        : sistemaOscuro.matches ? 'dark' : 'light';
      const actualizarEtiqueta = () => {
        const siguiente = modoActual() === 'dark' ? 'light' : 'dark';
        const etiqueta = boton.getAttribute('data-etiqueta-' + siguiente);
        if (etiqueta) {
          boton.setAttribute('aria-label', etiqueta);
          boton.setAttribute('title', etiqueta);
        }
      };
      actualizarEtiqueta();
      boton.addEventListener('click', () => {
        raiz.dataset.tema = modoActual() === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('tema', raiz.dataset.tema);
        } catch (e) {}
        actualizarEtiqueta();
      });
      sistemaOscuro.addEventListener('change', () => {
        if (!raiz.dataset.tema) actualizarEtiqueta();
      });
    }
  }
</script>
