---
import Base from './Base.astro';
import { RUTAS, UI, formatearFecha, type Idioma } from '../i18n/ui';

interface Props {
  titulo: string;
  descripcion: string;
  fecha: Date;
  idioma: Idioma;
  slug: string;
  alternas?: Partial<Record<Idioma, string>>;
}

const { titulo, descripcion, fecha, idioma, slug, alternas = {} } = Astro.props;
const t = UI[idioma];
---

<Base
  titulo={titulo}
  descripcion={descripcion}
  idioma={idioma}
  alternas={alternas}
  tipo="article"
  fecha={fecha}
  progreso
>
  <article class="envoltorio">
    <header class="cabecera-pagina">
      <p class="rotulo ensayo__meta">
        <time datetime={fecha.toISOString().slice(0, 10)}>{formatearFecha(fecha, idioma)}</time>
      </p>
      <h1 style={`view-transition-name: ensayo-${slug}`}>{titulo}</h1>
      <p class="cabecera-pagina__descripcion">{descripcion}</p>
    </header>
    <div class="prosa">
      <slot />
    </div>
    <p class="cierre-ensayo">
      <a class="enlace-mas" href={RUTAS[idioma].ensayos}>{t.volverEnsayos}</a>
    </p>
  </article>
</Base>
