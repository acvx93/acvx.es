---
import Base from '../layouts/Base.astro';
import ListaEnsayos from '../components/ListaEnsayos.astro';
import Trayectoria from '../components/Trayectoria.astro';
import { COORDENADA, RUTAS, UI } from '../i18n/ui';
import { ensayosDe } from '../lib/ensayos';

const idioma = 'es' as const;
const t = UI[idioma];
const ensayos = (await ensayosDe(idioma)).slice(0, 3);
const alternas = { es: RUTAS.es.inicio, en: RUTAS.en.inicio };
---

<Base
  titulo="Alejandro Couso"
  descripcion="Alejandro Couso, ingeniero industrial en A Coruña. Sistemas de IA aplicada y producto propio, contado desde dentro."
  idioma={idioma}
  alternas={alternas}
>
  <section class="entrada envoltorio">
    <p class="rotulo entrada__coordenada revelar">{COORDENADA} · {t.lugar}</p>

    <h1 class="nombre">
      <span class="mascara"><i>Alejandro</i></span>
      <span class="mascara"><i>Couso</i></span>
    </h1>

    <p class="entrada__declaracion revelar" data-retardo="0.15">
      Construyo sistemas de IA aplicada y, desde hace un tiempo, <span class="entrada__acento">producto propio</span>.
    </p>

    <ul class="credenciales revelar" data-retardo="0.25">
      {t.credenciales.map((credencial) => <li>{credencial}</li>)}
    </ul>

    <p class="rotulo aviso-scroll revelar" data-retardo="0.45">{t.trayectoriaRotulo}</p>
  </section>

  <Trayectoria idioma={idioma} />

  {
    ensayos.length > 0 && (
      <section class="seccion envoltorio" aria-labelledby="ensayos">
        <div class="seccion__cabecera">
          <h2 class="seccion__titulo revelar" id="ensayos">
            {t.ultimosEnsayos}
          </h2>
          <p class="rotulo revelar">{t.escrituraRotulo}</p>
        </div>
        <ListaEnsayos entradas={ensayos} idioma={idioma} />
        <a class="enlace-mas revelar" href={RUTAS.es.ensayos}>
          {t.todosLosEnsayos}
        </a>
      </section>
    )
  }
</Base>
