---
import { render } from 'astro:content';
import Ensayo from '../../../layouts/Ensayo.astro';
import { alternasDe, ensayosDe, slugDe } from '../../../lib/ensayos';

export async function getStaticPaths() {
  const entradas = await ensayosDe('en');
  return entradas.map((entrada) => ({ params: { slug: slugDe(entrada) }, props: { entrada } }));
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const alternas = await alternasDe(entrada);
---

<Ensayo
  titulo={entrada.data.titulo}
  descripcion={entrada.data.descripcion}
  fecha={entrada.data.fecha}
  idioma="en"
  alternas={alternas}
>
  <Content />
</Ensayo>
